# Makefile for {{ base_name }} inference
# Auto-generated - compiles the inference executable

CXX = g++
CXXFLAGS = -std=c++17 -O2 -Wall

# Source files
SOURCES = {{ base_name }}_weights.cpp \
          {{ base_name }}.cpp \
          {{ base_name }}_inference.cpp

# Header files
HEADERS = {{ base_name }}.h

OBJECTS = $(SOURCES:.cpp=.o)
TARGET = {{ base_name }}_inference

$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) -o $(TARGET) $(OBJECTS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS) $(TARGET)

.PHONY: clean

